# Copy to .env.production ON THE SERVER and fill in. Never commit the result.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   docker compose --env-file .env.production \
#     -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up -d --build
#
# This is read by Docker, not by a shell: do NOT quote values. `SECRET_KEY="ab"`
# signs your tokens with a key that literally starts and ends with a quote mark.
# There is no ${...} expansion inside this file either — write values in full.

# ── Database ──────────────────────────────────────────────────────────────
# Used by the db service. The password must match the one in DATABASE_URL.
POSTGRES_USER=pfa
POSTGRES_PASSWORD=
POSTGRES_DB=pfa

# The host is db:5432 — the compose service name and Postgres' INTERNAL port.
# Not localhost:5433: inside the api container localhost is the api container.
# The 5433 in .env.example exists only for running the app on your laptop.
# Keep the +asyncpg driver; a plain postgresql:// fails at engine creation.
DATABASE_URL=postgresql+asyncpg://pfa:CHANGE_ME@db:5432/pfa

# ── Secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Rotating this invalidates every issued access token; users re-authenticate.
SECRET_KEY=

# The WEB OAuth client id, not the Android one — see .env.example for why.
# Comma-separated if you accept more than one.
GOOGLE_CLIENT_IDS=

# ── App ───────────────────────────────────────────────────────────────────
# False in production: DEBUG defaults to True in src/core/config.py.
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────
# The Android client sends no Origin header, so this only affects browsers.
# Narrow it from the "*" default if any browser tooling talks to this API.
CORS_ALLOW_ORIGINS=https://your-domain

# ── Optional ──────────────────────────────────────────────────────────────
# Everything below has a sane default in src/core/config.py; uncomment only to change it.
# JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
# REFRESH_TOKEN_EXPIRE_SECONDS=2592000
# SYNC_MAX_BATCH=1000
# SYNC_MAX_PULL=500
# MAX_REQUEST_BYTES=2097152
# RATE_LIMIT_GOOGLE=10/minute
# RATE_LIMIT_REFRESH=30/minute
