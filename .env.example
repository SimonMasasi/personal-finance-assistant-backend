# ── Required ──────────────────────────────────────────────────────────────
# Must be the asyncpg driver URL — SQLAlchemy picks the async driver from the
# scheme, and a plain postgresql:// here fails at engine creation.
# Port 5433 matches docker-compose.yml, which avoids 5432 so it does not clash
# with a natively-installed Postgres.
DATABASE_URL="postgresql+asyncpg://pfa:pfa@localhost:5433/pfa"

# At least 32 characters. Signs the JWT access tokens.
SECRET_KEY="change-me-to-a-long-random-string-at-least-32-chars"

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=True
APP_HOST="0.0.0.0"
APP_PORT=8000

# ── Tokens ────────────────────────────────────────────────────────────────
# Access ~15 min, refresh 30 days. Refresh tokens rotate on every use.
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# ── Sync limits ───────────────────────────────────────────────────────────
SYNC_MAX_BATCH=1000
SYNC_MAX_PULL=500
MAX_REQUEST_BYTES=2097152

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. The Android client sends no Origin header, so this only
# matters for browser-based tooling.
CORS_ALLOW_ORIGINS="*"
